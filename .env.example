# Vision AI — preferred production env (copy to Railway)
APP_BASE_URL=https://your-app.up.railway.app
ALLOWED_HOSTS=your-app.up.railway.app,healthcheck.railway.app,localhost,127.0.0.1
SECRET_KEY=change-me-long-random
SESSION_SECRET=change-me-long-random

# LLM providers (at least one)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional search, image and video features
TAVILY_API_KEY=
HF_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_ENGINE_ID=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback

# Optional payments and notifications
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional external GPU workers
RUNPOD_API_KEY=
WORKER_SECRET=
WORKER_REGISTER_SECRET=
COLAB_WORKER_SECRET=

# Optional Mongo
MONGODB_URI=
MONGODB_DB=vision_ai

# SEO
SEO_TITLE=Vision AI — AI Chat, Code, Data & Studio
SEO_DESCRIPTION=Multimodal AI assistant for chat, coding, data lab, image and video.
SEO_SAME_AS=

# Ads (off until AdSense approved)
ADS_ENABLED=0
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_FOOTER=
ADS_FREE_ONLY=1

# Plans (PKR)
STUDENT_PRICE_PKR=1499
PRO_PRICE_PKR=2799
