# Vision AI v3.2.2 — Environment template
# Copy to .env and fill values. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-me-too
DEBUG=false
HOST=0.0.0.0
PORT=5050
# Hostnames only (no scheme). Required in production — do not use *
ALLOWED_HOSTS=vision-ai.example.com,healthcheck.railway.app
# Full origins for CORS (scheme + host). Prefer this over deriving from ALLOWED_HOSTS
CORS_ORIGINS=https://vision-ai.example.com
# Keep at 1 until users/payments are moved to Postgres/Redis
WEB_WORKERS=1

# --- Usage quotas (server-enforced) ---
GUEST_MESSAGES_MAX=5
FREE_MESSAGES_PER_MONTH=30
FREE_MESSAGES_PER_DAY=30
# Paid plans ignore these caps

LOG_LEVEL=INFO

# --- Free AI providers (at least one recommended) ---
# Single key:
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=
# Multiple keys for rotation / higher free quota (optional):
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
# GOOGLE_API_KEY_1=AIza...
# GOOGLE_API_KEY_2=AIza...
# OPENROUTER_API_KEY_1=sk-or-...
# Or comma-separated in one var: GROQ_API_KEY=key1,key2,key3
# Vault rotates round-robin across all keys found for each provider.

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs
# Local:
GOOGLE_REDIRECT_URI=http://localhost:5050/auth/google/callback
# Production example (Railway):
# GOOGLE_REDIRECT_URI=https://vision-ai-v2-production.up.railway.app/auth/google/callback
# APP_BASE_URL=https://vision-ai-v2-production.up.railway.app
APP_BASE_URL=


# --- Manual payments (Easypaisa / Bank) — Pakistan style ---
PRO_PRICE_PKR=1499
TEAM_PRICE_PKR=3999
EASYPAISA_NUMBER=
EASYPAISA_TITLE=
BANK_NAME=Mashreq Neo
BANK_IBAN=
BANK_ACCOUNT_TITLE=
PAYMENT_NOTE=After payment, submit your Transaction ID. Access activates after owner verification.

# ============================================================
# OWNER NOTIFICATIONS when a user submits payment
# (all free, no credit card — pick any one)
# ============================================================

# --- RECOMMENDED: Telegram (most reliable) ---
# 1. Open Telegram → search @BotFather → /newbot → copy the token
# 2. Start a chat with your new bot (send any message)
# 3. Open in browser: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 4. Find "chat":{"id": 123456789}  ← that number is TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Easy alternative: ntfy.sh (no account needed) ---
# 1. Install "ntfy" app on phone (Play Store / App Store)
# 2. Subscribe to a secret topic name you invent (e.g. vision-ai-pay-xyz99)
# 3. Put the same topic name below
NTFY_TOPIC=

# --- Optional: WhatsApp via CallMeBot (often full / key delayed) ---
# Try bot numbers: +34 644 10 28 72   or   +34 623 78 64 49
# Send: I allow callmebot to send me messages
# If no reply in 2 min → wait 24h OR send: Recover APIKey
# Phone format: 923xxxxxxxxx (country code, no +)
PAYMENT_WHATSAPP=
CALLMEBOT_APIKEY=

# --- Optional: any HTTPS webhook (Discord, custom server, etc.) ---
PAYMENT_WEBHOOK_URL=

# --- Stripe (optional, paid plans card checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5050/upgrade.html?success=1
STRIPE_CANCEL_URL=http://localhost:5050/upgrade.html?canceled=1

# --- Rate limits ---
RATE_LIMIT_CHAT=60/minute
RATE_LIMIT_SEARCH=20/minute

# --- Optional: Google Colab GPU worker (better models/images while session live) ---
# Run colab_worker_server.py in Colab + ngrok, then paste URL here
COLAB_WORKER_URL=
COLAB_WORKER_SECRET=vision-colab-secret
COLAB_CHAT_TIMEOUT=90
COLAB_IMAGE_TIMEOUT=120

# Multi free workers (Colab + Kaggle + extras)
KAGGLE_WORKER_URL=
WORKER_URLS=
WORKER_REGISTER_SECRET=
WORKER_TTL_SEC=900
MAIN_APP_URL=

# --- Optional: RunPod Serverless GPU (power users — uses YOUR RunPod credits) ---
# Create a serverless endpoint (FLUX/SDXL template), then set:
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_SEC=180
RUNPOD_IMAGE_MODEL=

# --- Colab low-VRAM mode (default on) ---
LOW_VRAM=1

# --- Colab / GPU worker (optional) ---
WORKER_SECRET=vision-colab-secret
COLAB_WORKER_URL=
COLAB_IMAGE_TIMEOUT=240
COLAB_CHAT_TIMEOUT=22

# ----- Monetization (Pakistan) -----
FREE_MESSAGES_PER_MONTH=30
FREE_FILE_MB=10
FREE_IMAGES_PER_DAY=3
PRO_PRICE_PKR=799
PRO_MESSAGES_PER_MONTH=2000
PRO_IMAGES_PER_DAY=30
STUDENT_PRICE_PKR=399
STUDENT_MESSAGES_PER_MONTH=1500
# Shown on /upgrade.html (manual verification)
EASYPAISA_NUMBER=
EASYPAISA_NAME=Vision AI
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
PAYMENT_WHATSAPP=

ALLOW_GUEST=1
GUEST_MESSAGES_MAX=5
X_ROBOTS_TAG=index, follow

# OpenAPI UI at /docs and /redoc (set 1 only if you want public API docs)
ENABLE_DOCS=0
MAX_CHAT_MESSAGE=20000


# ============================================================
# Local / OpenAI-compatible LLM (Ollama, LM Studio, vLLM, ...)
# ============================================================
LOCAL_LLM_ENABLED=1
OPENAI_COMPAT_BASE=
OPENAI_COMPAT_KEY=ollama
OPENAI_COMPAT_MODEL=llama3.2
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LMSTUDIO_BASE=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
USE_COLAB_LOCAL_LLM=1

# Image gen: 0 = Colab downloaded models only (recommended)
IMAGE_ALLOW_CLOUD=0
GROQ_MAX_TRIES=2
OPENROUTER_MAX_TRIES=4

# --- PDF / RAG (exam solve) ---
PDF_OCR_MAX_PAGES=40
RERANK_ENABLED=1
# Full-document intents (solve this pdf) skip top-k RAG automatically in code.

# --- Exam / long document (optional tuning) ---
DOC_PROVIDER_TIMEOUT=120
DOC_MAX_TOKENS=8192
PDF_OCR_MAX_PAGES=40

# YouTube / yt-dlp (Railway often needs cookies or proxy)
# YTDLP_COOKIES=cookies.txt
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_AUTO_PROXY=1

# Tor local: YTDLP_PROXY=socks5://127.0.0.1:9050
# Or Railway: YTDLP_AUTO_PROXY=1 / YTDLP_COOKIES=cookies.txt

# YouTube: NEVER set YTDLP_PROXY=socks5://127.0.0.1:9050 on Railway (Tor is not running there).
# YTDLP_COOKIES=cookies.txt
# YTDLP_PROXY=http://user:pass@remote-host:port
# YTDLP_AUTO_PROXY=1
# YTDLP_ALLOW_LOCAL_PROXY=1
